@namespace LocalFarmer2.Client.Pages

@inject IAlertPremiumService AlertPremiumService
@inject AuthenticationStateProvider AuthProvider
@inject UserStateService UserStateService

@if (_showAlert)
{
    <div class="alert alert-warning alert-dismissible" role="alert">
        <strong>⏳ @loc["Alert_Premium_Expiry1"] @_daysLeft @loc["Alert_Premium_Expiry2"]</strong>
        @loc["Alert_Premium_Expiry3"]
        <a href="/myaccount" class="btn btn-sm btn-warning ms-2">Premium</a>
        <button type="button" class="btn-close" @onclick="Dismiss"></button>
    </div>
}

@code {
    private bool _showAlert;
    private int _daysLeft;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true) return;

        var user = UserStateService.CurrentUser;
        if (user == null) return;

        if (AlertPremiumService.ShouldShowAlert(user.DatePremium, user.IsPremium))
        {
            if (!await AlertPremiumService.WasAlertShownTodayAsync())
            {
                _daysLeft = AlertPremiumService.GetDaysLeft(user.DatePremium);
                _showAlert = true;
                await AlertPremiumService.MarkAlertShownAsync();
                StateHasChanged();
            }
        }
    }

    private void Dismiss() => _showAlert = false;
}